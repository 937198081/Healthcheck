import tkinter as tk
from tkinter import ttk
from tkinter import messagebox


class HealthCheckApp(tk.Tk):
    def __init__(self) -> None:
        super().__init__()
        self.title("HealthCheck GUI")
        self.geometry("1000x1000")
        self.resizable(False, False)

        self.accounts: dict[str, str] = {}
        self.current_user: str 

        self.login_frame = ttk.Frame(self)
        self.main_frame = ttk.Frame(self)

        self._build_login_frame()
        self._build_main_frame()
        self._show_frame(self.login_frame)

    def _show_frame(self, frame: ttk.Frame) -> None:
        frame.pack(fill=tk.BOTH, expand=True)
        for f in (self.login_frame, self.main_frame):
            if f is not frame:
                f.pack_forget()

    def _build_login_frame(self) -> None:
        frame = self.login_frame
        ttk.Label(frame, text="HealthCheck Login").pack(pady=10)

        user_frame = ttk.Frame(frame)
        user_frame.pack(fill=tk.X, pady=5, padx=20)
        ttk.Label(user_frame, text="Username:", width=15).pack(side=tk.LEFT)
        self.username_entry = ttk.Entry(user_frame)
        self.username_entry.pack(side=tk.LEFT, fill=tk.X, expand=True)

        pass_frame = ttk.Frame(frame)
        pass_frame.pack(fill=tk.X, pady=5, padx=20)
        ttk.Label(pass_frame, text="Password:", width=15).pack(side=tk.LEFT)
        self.password_entry = ttk.Entry(pass_frame, show="*")
        self.password_entry.pack(side=tk.LEFT, fill=tk.X, expand=True)

        mode_frame = ttk.Frame(frame)
        mode_frame.pack(fill=tk.X, pady=5)
        ttk.Label(mode_frame, text="Choose action:").pack(side=tk.LEFT, padx=5)
        self.mode_var = tk.StringVar(value="login")
        ttk.Radiobutton(mode_frame, text="Login", variable=self.mode_var, value="login").pack(side=tk.LEFT, padx=5)
        ttk.Radiobutton(mode_frame, text="Create Account", variable=self.mode_var, value="create").pack(side=tk.LEFT, padx=5)

        ttk.Button(frame, text="Proceed", command=self._handle_login_or_create).pack(pady=15)

    def _handle_login_or_create(self):
        username = self.username_entry.get().strip()
        password = self.password_entry.get().strip()
        mode = self.mode_var.get()
        if not username or not password:
            messagebox.showwarning("Input Required", "Please enter both username and password.")
            return

        if mode == 'login':
            if username in self.accounts and self.accounts[username] == password:
                self.current_user = username
                self.greeting_label.config(text=f"Welcome, {username}!")
                self._show_frame(self.main_frame)
            else:
                messagebox.showerror("Login Failed", "Incorrect username or password.")
        else:
            if username in self.accounts:
                messagebox.showerror("Account Exists", "This username is already taken. Please choose another.")
            else:
                self.accounts[username] = password
                self.current_user = username
                self.greeting_label.config(text=f"Welcome, {username}!")
                messagebox.showinfo("Account Created", "Account successfully created!")
                self._show_frame(self.main_frame)

        self.username_entry.delete(0, tk.END)
        self.password_entry.delete(0, tk.END)

    def _logout(self):
        self.output_area.configure(state='normal')
        self.output_area.delete(1.0, tk.END)
        self.output_area.configure(state='disabled')

        for var in (self.height_var, self.weight_var, self.age_var):
            var.set("")
        self.gender_var.set("M")
        self.act_var.set("A")
        for var in self.servings_vars.values():
            var.set("0")
        self._show_frame(self.login_frame)

    def _build_main_frame(self):
        frame = self.main_frame

        self.greeting_label = ttk.Label(frame, text="")
        self.greeting_label.pack(pady=5)

        h_frame = ttk.Frame(frame)
        h_frame.pack(fill=tk.X, pady=2, padx=20)
        ttk.Label(h_frame, text="Height (m):", width=20).pack(side=tk.LEFT)
        self.height_var = tk.StringVar()
        ttk.Entry(h_frame, textvariable=self.height_var).pack(side=tk.LEFT, fill=tk.X, expand=True)

        w_frame = ttk.Frame(frame)
        w_frame.pack(fill=tk.X, pady=2, padx=20)
        ttk.Label(w_frame, text="Weight (kg):", width=20).pack(side=tk.LEFT)
        self.weight_var = tk.StringVar()
        ttk.Entry(w_frame, textvariable=self.weight_var).pack(side=tk.LEFT, fill=tk.X, expand=True)

        age_frame = ttk.Frame(frame)
        age_frame.pack(fill=tk.X, pady=2, padx=20)
        ttk.Label(age_frame, text="Age (years):", width=20).pack(side=tk.LEFT)
        self.age_var = tk.StringVar()
        ttk.Entry(age_frame, textvariable=self.age_var).pack(side=tk.LEFT, fill=tk.X, expand=True)

        gender_frame = ttk.Frame(frame)
        gender_frame.pack(fill=tk.X, pady=2, padx=20)
        ttk.Label(gender_frame, text="Gender (M/F):", width=20).pack(side=tk.LEFT)
        self.gender_var = tk.StringVar(value="M")
        ttk.OptionMenu(gender_frame, self.gender_var, "M", "M", "F").pack(side=tk.LEFT)

        act_frame = ttk.LabelFrame(frame, text="Activity Level")
        act_frame.pack(fill=tk.X, pady=5, padx=20)
        self.act_var = tk.StringVar(value="A")
   
        self.level_map: dict[str, float] = {'A': 1.2,'B': 1.375,'C': 1.55,'D': 1.725,'E': 1.9,}

        act_labels = [("A", "0-30 minutes"),("B", "30-60 minutes"),("C", "60-90 minutes"),("D", "90-120 minutes"),("E", "120+ minutes"),]
        for row, (code, label) in enumerate(act_labels):
            ttk.Radiobutton(act_frame, text=f"{code}: {label}", variable=self.act_var, value=code).grid(row=row, column=0, sticky=tk.W, pady=2)

        food_frame = ttk.LabelFrame(frame, text="Food Servings")
        food_frame.pack(fill=tk.X, pady=5, padx=20)
        food_data = [("A", "Main carbs (rice/noodles 100g or bread 2 slices)", 260),("B", "Meat/Eggs (150g chicken/100g beef/2 eggs)", 270),("C", "Vegetables (200g cooked/100g salad)", 40),("D", "Fruits (1 medium or 200g slices)", 80),("E", "Dairy (250 ml milk/200g yogurt)", 130),("F", "Sweet drinks/desserts (milk tea/cake/cookies)", 200),("G", "Fried snacks (fries/fried chicken/chips)", 240),]
        self.servings_vars: dict[str, tk.StringVar] = {}
        self.kcal_map: dict[str, int] = {}
        for idx, (code, desc, kcal) in enumerate(food_data):
           
            ttk.Label(food_frame, text=f"{code} servings:").grid(row=idx, column=0, sticky=tk.W, pady=2)

            var = tk.StringVar(value="0")
            ttk.Entry(food_frame, textvariable=var, width=5).grid(row=idx, column=1, sticky=tk.W, pady=2)
            ttk.Label(food_frame, text=desc, wraplength=380).grid(row=idx, column=2, sticky=tk.W, padx=5)
            self.servings_vars[code] = var
            self.kcal_map[code] = kcal

        ttk.Button(frame, text="Calculate", command=self._calculate_health).pack(pady=10)
        self.output_area = tk.Text(frame, height=16, wrap=tk.WORD, state='disabled')
        self.output_area.pack(fill=tk.BOTH, expand=True, padx=10, pady=5)

        ttk.Button(frame, text="Logout", command=self._logout).pack(pady=5)

    def _calculate_health(self):
        try:
            height = float(self.height_var.get())
            weight = float(self.weight_var.get())
            age = int(self.age_var.get())
            gender = self.gender_var.get().strip().lower()
            if height <= 0 or weight <= 0 or age <= 0 or gender not in ('m', 'f'):
                raise ValueError
        except ValueError:
            messagebox.showerror("Invalid Input","Please enter valid numeric values for height, weight and age, and choose a valid gender.")
            return

        bmi = weight / (height ** 2)
        if bmi < 18.5:
            category = "underweight"
        elif bmi < 24.9:
            category = "normal"
        elif bmi < 29.9:
            category = "overweight"
        else:
            category = "obese"

        height_cm = height * 100
        if gender == 'm':
            bmr = 10 * weight + 6.25 * height_cm - 5 * age + 5
        else:
            bmr = 10 * weight + 6.25 * height_cm - 5 * age - 161

        act_code = self.act_var.get().upper()
        activity_factor = self.level_map.get(act_code, 1.2)
        tdee = bmr*activity_factor

        intake = 0
        for code, var in self.servings_vars.items():
            try:
                n = int(var.get())
                if n < 0:
                    n = 0
            except ValueError:
                n = 0
            intake += n*self.kcal_map[code]

        diff = intake - tdee
        if diff < -200:
            status = "lower than"
        elif diff > 200:
            status = "higher than"
        else:
            status = "close to"

        maintain_low, maintain_high = tdee - 200, tdee + 200
        cut_low, cut_high = tdee - 500, tdee - 300
        bulk_low, bulk_high = tdee + 250, tdee + 500

        if category in ("overweight", "obese") or diff > 200:
            plan = "fat loss"
            target_low, target_high = cut_low, cut_high
        elif category == "underweight" or diff < -200:
            plan = "lean bulk"
            target_low, target_high = bulk_low, bulk_high
        else:
            plan = "maintenance"
            target_low, target_high = maintain_low, maintain_high

        if plan == "fat loss":
            note = "Create a moderate deficit; focus on protein and vegetables."
        elif plan == "lean bulk":
            note = "Slight surplus; combine strength training; high protein intake."
        else:
            note = "Keep current habits; mix cardio and strength."

        if diff > 200:
            note += " Tip: You are likely in a calorie surplus today; reduce high-sugar/high-fat snacks."
        elif diff < -200:
            note += " Tip: You are likely in a calorie deficit today; avoid excessive hunger and ensure protein/veggie intake."
        else:
            note += " Tip: Intake is close to maintenance today. Keep up good habits and regular exercise."


        if act_code == 'A':
            goals = "Steps 6000, water 1.8L, protein 1.6 g/kg"
        elif act_code == 'B':
            goals = "Steps 7000, water 2.0L, protein 1.6-2.0 g/kg"
        elif act_code == 'C':
            goals = "Steps 8000-10000, water 2.2L, protein 1.8-2.2 g/kg"
        elif act_code == 'D':
            goals = "Steps 10000-12000, water 2.5L, protein 2.0-2.2 g/kg"
        else:
            goals = "Steps 12000+, water 2.7L, protein 2.0-2.2 g/kg"

        lines = [f"Hello, {self.current_user}!",f"BMI: {bmi:.2f} ({category})",f"BMR: {bmr:.0f} kcal/day",f"TDEE: {tdee:.0f} kcal/day",f"Estimated intake today: {intake:.0f} kcal",f"Calorie intake compared to maintenance: {status} (difference {diff:+.0f} kcal)",f"Maintain weight: {maintain_low:.0f} – {maintain_high:.0f} kcal/day",f"Fat loss: {cut_low:.0f} - {cut_high:.0f} kcal/day",f"Muscle gain: {bulk_low:.0f} - {bulk_high:.0f} kcal/day",f"Recommendation: {plan} | Daily target: {target_low:.0f} - {target_high:.0f} kcal/day",note,f"Daily goals (level {act_code}): {goals}"]

        self.output_area.configure(state='normal')
        self.output_area.delete(1.0, tk.END)
        self.output_area.insert(tk.END, "\n".join(lines))
        self.output_area.configure(state='disabled')

if __name__ == "__main__":
    app = HealthCheckApp()
    app.mainloop()
